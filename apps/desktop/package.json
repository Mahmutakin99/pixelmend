{
  "name": "pixelmend",
  "version": "1.0.0-rc.2",
  "private": true,
  "description": "Local photo repair and image enhancement desktop application",
  "homepage": "https://github.com/Mahmutakin99/pixelmend",
  "author": {
    "name": "Mahmut AKIN",
    "email": "Mahmutakin99@users.noreply.github.com"
  },
  "main": "electron/main.cjs",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "start": "electron .",
    "test:e2e": "node e2e/editor.cjs",
    "build:engine": "uv --directory ../../engine run pyinstaller --clean --noconfirm --distpath dist --workpath build pixelmend-engine.spec",
    "package": "corepack pnpm build:engine && corepack pnpm build && electron-builder --publish never",
    "package:mac": "corepack pnpm package --mac dmg zip --arm64",
    "package:win": "corepack pnpm package --win nsis --x64",
    "package:linux": "corepack pnpm package --linux AppImage deb --x64",
    "test:ci-tools": "node --test ../../tools/ci/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "directories": {
      "output": "out.noindex"
    },
    "appId": "com.mahmutakin.pixelmend",
    "productName": "PixelMend",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "extraResources": [
      {
        "from": "../../engine/dist/pixelmend-engine",
        "to": "engine"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "category": "public.app-category.photography"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": ["nsis"]
    },
    "linux": {
      "icon": "build/icons",
      "category": "Graphics",
      "desktopName": "PixelMend",
      "target": ["AppImage", "deb"]
    },
    "deb": {
      "maintainer": "Mahmut AKIN <Mahmutakin99@users.noreply.github.com>"
    }
  }
}
