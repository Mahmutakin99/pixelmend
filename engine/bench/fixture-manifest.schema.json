{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "path", "source_url", "license", "downloaded_at", "sha256", "input_width", "input_height", "expected_use"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
      "path": {"type": "string"}, "source_url": {"type": "string", "format": "uri"},
      "license": {"enum": ["CC0-1.0", "Public-Domain"]}, "downloaded_at": {"type": "string", "format": "date"},
      "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "input_width": {"type": "integer", "minimum": 1}, "input_height": {"type": "integer", "minimum": 1},
      "expected_use": {"enum": ["inpainting", "upscale", "both"]}
    }
  }
}
