# --- Model ağırlıkları: asla commitlenmez ---
*.onnx
*.safetensors
*.ckpt
*.bin
*.pt
*.pth
engine/models_cache/
**/models/downloaded/

# --- Python (engine/) ---
__pycache__/
*.pyc
.venv/
.python-version
*.egg-info/
dist/
build/
!apps/desktop/build/
!apps/desktop/build/icon.svg
!apps/desktop/build/icon.png
!apps/desktop/build/icon.icns
!apps/desktop/build/icon.ico
!apps/desktop/build/icons/
!apps/desktop/build/icons/*.png
.pytest_cache/
.ruff_cache/

# --- Node / Electron (apps/desktop/) ---
node_modules/
apps/desktop/dist/
apps/desktop/dist-electron/
apps/desktop/release/
.vite/

# --- Genel ---
.worktrees/
.DS_Store
*.log
.env
.env.local
apps/desktop/test-results/
apps/desktop/out/
apps/desktop/out.noindex/
:memory:.ses

# Generated release installers stay local; source and test kits remain versioned.
/release/**/*.zip
/release/**/*.AppImage
/release/**/*.deb
/release/**/*.exe
/release/**/*.dmg
/release/macos/*-signed/mac-arm64/
/release/**/*.blockmap

# Local release evidence and agent notes are not public source documentation.
/release/
/.local-notes/

# Keep local agent configuration and work logs out of the public source tree.
/.ai/
/.claude/
/.codex/
/docs/
/CLAUDE.md
/AGENTS.md
/DURUM.md
/MANUAL_TEST.md
/AI_AJANI_DEVIR_BELGESI.md

# Generated diagnostics stay local; curated text evidence is committed explicitly.
/release/macos/**/verification/

# Licensed benchmark pixels are local; provenance remains versioned.
engine/bench/fixtures/
